// Warehouse & Multi-Shop Management System — Prisma schema.
// Phase 1: foundation (User, Session, Shop, Location, AppSetting).
// Phase 2: core master data (Category, Product, Customer, ExpenseCategory).
// Phase 3: warehouse & incoming orders (ReferenceCounter, IncomingOrder(+Items),
//          StockReceipt(+Items), InventoryBalance, InventoryMovement, StockCorrection).
// Later phases add their own tables via new migrations.
// See docs/architecture.md §6 for the ORM contract; conventions.md §3 for migration rules.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  WAREHOUSE
  SHOP
}

enum LocationType {
  WAREHOUSE
  SHOP
}

model User {
  id             String    @id @default(cuid())
  name           String
  username       String    @unique // phone number or chosen username
  passwordHash   String
  role           Role
  // Required iff role = SHOP. Enforced in the users service, not the schema.
  assignedShopId String?
  assignedShop   Shop?     @relation(fields: [assignedShopId], references: [id])
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  sessions       Session[]
}

model Session {
  // 32-byte random token, generated server-side.
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Shop {
  id            String             @id @default(cuid())
  name          String
  address       String?
  phone         String?
  active        Boolean            @default(true)
  archivedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  users         User[]
  location      Location?
  // Phase 5 back-relations
  sales         Sale[]
  // Phase 6 back-relations (money-received-by-shop, per phase-6 §3 step 8)
  payments      CustomerPayment[]
  // Phase 7 back-relations
  expenses      Expense[]
  productPrices ShopProductPrice[]
}

model Location {
  id           String              @id @default(cuid())
  name         String
  type         LocationType
  // Null for the central warehouse; unique per shop.
  shopId       String?             @unique
  shop         Shop?               @relation(fields: [shopId], references: [id])
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now())
  // Phase 3 back-relations
  balances     InventoryBalance[]
  movementsOut InventoryMovement[] @relation("movementSource")
  movementsIn  InventoryMovement[] @relation("movementDestination")
  corrections  StockCorrection[]
  // Phase 4 back-relations
  transfersOut StockTransfer[]     @relation("transferSource")
  transfersIn  StockTransfer[]     @relation("transferDestination")
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ---------- Phase 2: core master data ----------

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id                  String              @id @default(cuid())
  name                String
  // sku/barcode are optional but unique when present. Postgres allows
  // multiple NULLs in a UNIQUE column, which is what we want.
  sku                 String?             @unique
  barcode             String?             @unique
  categoryId          String
  category            Category            @relation(fields: [categoryId], references: [id])
  description         String?
  imageUrl            String?
  // Money is whole MRU (D-004). Both prices optional per spec §10.1.
  defaultPurchaseCost Int?
  defaultSalePrice    Int?
  lowStockThreshold   Int?
  active              Boolean             @default(true)
  archivedAt          DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  // Phase 3 back-relations (used by hasHistory + the inventory reads)
  incomingOrderItems  IncomingOrderItem[]
  stockReceiptItems   StockReceiptItem[]
  inventoryBalances   InventoryBalance[]
  inventoryMovements  InventoryMovement[]
  stockCorrections    StockCorrection[]
  // Phase 4 back-relations
  stockTransferItems  StockTransferItem[]
  // Phase 5 back-relations
  saleItems           SaleItem[]
  // Per-shop sale price overrides
  shopPrices          ShopProductPrice[]

  @@index([categoryId])
  @@index([name])
}

// Per-shop sale price. Shops decide their own sale price (spec §2 —
// warehouse handles cost, shop handles retail). A missing row means the
// shop hasn't set a price yet — sale flow lets the clerk type one at
// point of sale, but the picker shows "—" until an override exists.
model ShopProductPrice {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  salePrice Int
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([shopId, productId])
  @@index([productId])
}

model Customer {
  id        String            @id @default(cuid())
  name      String
  // Phone is deliberately NOT unique — family members share phones (spec §18.4).
  phone     String?
  notes     String?
  active    Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  // Phase 5 back-relations
  sales     Sale[]
  // Phase 6 back-relations
  payments  CustomerPayment[]

  @@index([name])
  @@index([phone])
}

model ExpenseCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  // Phase 7 back-relations
  expenses  Expense[]
}

// ---------- Phase 3: warehouse & incoming orders ----------

enum OrderStatus {
  ORDERED
  SHIPPED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

// MovementType covers Phases 3–7 up front (schema-review §7): adding an enum
// value later needs its own migration, so we settle it now and use only the
// values the code emits per phase.
enum MovementType {
  OPENING_STOCK
  ORDER_RECEIPT
  DIRECT_RECEIPT
  TRANSFER // Phase 4
  SALE // Phase 5
  SALE_CANCELLATION // Phase 6
  CUSTOMER_RETURN // Phase 6 (if built)
  STOCK_CORRECTION
}

// Per-kind counter row; incremented under FOR UPDATE by ReferenceService.next
// (architecture §3.8). Rolled-back transactions may leave gaps — accepted.
model ReferenceCounter {
  kind  String @id // "ORD" | "REC" | "TRF" | "SAL" | "PAY" | "EXP" | "ADJ"
  value Int    @default(0)
}

model IncomingOrder {
  id                  String              @id @default(cuid())
  referenceNumber     String              @unique
  supplierName        String?
  orderDate           DateTime
  expectedArrivalDate DateTime?
  status              OrderStatus         @default(ORDERED)
  notes               String?
  createdBy           String
  cancelledBy         String?
  cancelledAt         DateTime?
  cancellationReason  String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  items               IncomingOrderItem[]
  receipts            StockReceipt[]

  @@index([status, orderDate])
  @@index([orderDate])
}

model IncomingOrderItem {
  id               String        @id @default(cuid())
  incomingOrderId  String
  order            IncomingOrder @relation(fields: [incomingOrderId], references: [id])
  productId        String
  product          Product       @relation(fields: [productId], references: [id])
  quantityOrdered  Int
  quantityReceived Int           @default(0)
  unitCost         Int? // whole MRU
  notes            String?

  @@index([incomingOrderId])
  @@index([productId])
}

model StockReceipt {
  id              String             @id @default(cuid())
  referenceNumber String             @unique
  // Null = direct receipt (spec §12); otherwise linked to the incoming order it fulfils.
  incomingOrderId String?
  order           IncomingOrder?     @relation(fields: [incomingOrderId], references: [id])
  receiptDate     DateTime
  supplierName    String?
  notes           String?
  createdBy       String
  createdAt       DateTime           @default(now())
  items           StockReceiptItem[]

  @@index([incomingOrderId])
  @@index([receiptDate])
}

model StockReceiptItem {
  id             String       @id @default(cuid())
  stockReceiptId String
  receipt        StockReceipt @relation(fields: [stockReceiptId], references: [id])
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  quantity       Int
  unitCost       Int?

  @@index([productId])
}

// Performance cache of the movement ledger. Written ONLY by
// InventoryService.applyMovement (D-008); invariant test asserts
// Σ movements = quantity per (location, product).
model InventoryBalance {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([locationId, productId])
  @@index([productId])
}

// The historical source of truth (architecture §3.5). quantity is ALWAYS > 0;
// direction is encoded by which side is set (D-011):
//   stock in:  destinationLocationId set (receipt, opening, +correction)
//   stock out: sourceLocationId set (sale, -correction)
//   move:      both set (transfer — one row, two balance changes)
model InventoryMovement {
  id                    String       @id @default(cuid())
  productId             String
  product               Product      @relation(fields: [productId], references: [id])
  movementType          MovementType
  quantity              Int
  sourceLocationId      String?
  sourceLocation        Location?    @relation("movementSource", fields: [sourceLocationId], references: [id])
  destinationLocationId String?
  destinationLocation   Location?    @relation("movementDestination", fields: [destinationLocationId], references: [id])
  // Freeform pointer to the emitting entity ("StockReceipt", "StockTransfer",
  // "Sale", "StockCorrection", ...). Kept as (type, id) strings on purpose:
  // one column that spans every emitter, no FK explosion, easy to filter.
  relatedEntityType     String?
  relatedEntityId       String?
  notes                 String?
  createdBy             String
  createdAt             DateTime     @default(now())

  @@index([productId, createdAt])
  @@index([sourceLocationId])
  @@index([destinationLocationId])
  @@index([relatedEntityType, relatedEntityId])
}

model StockCorrection {
  id                 String   @id @default(cuid())
  referenceNumber    String   @unique
  locationId         String
  location           Location @relation(fields: [locationId], references: [id])
  productId          String
  product            Product  @relation(fields: [productId], references: [id])
  // Signed as the human recorded it (+found / -removed). The paired movement
  // stores abs(quantity) with the side set from the sign (D-011).
  adjustmentQuantity Int
  reason             String
  notes              String?
  createdBy          String
  createdAt          DateTime @default(now())

  @@index([locationId, productId])
}

// ---------- Phase 4: stock transfers ----------

enum TransferStatus {
  COMPLETED
  REVERSED
}

// One transfer moves N items in one atomic operation between two DIFFERENT
// locations. There is no DRAFT status: transfers only exist once completed
// (schema-review §1). Reversal writes mirrored movements and flips the status
// to REVERSED — the original row is never rewritten.
model StockTransfer {
  id                    String              @id @default(cuid())
  referenceNumber       String              @unique
  sourceLocationId      String
  sourceLocation        Location            @relation("transferSource", fields: [sourceLocationId], references: [id])
  destinationLocationId String
  destinationLocation   Location            @relation("transferDestination", fields: [destinationLocationId], references: [id])
  status                TransferStatus      @default(COMPLETED)
  transferDate          DateTime
  notes                 String?
  createdBy             String
  reversedBy            String?
  reversedAt            DateTime?
  reversalReason        String?
  createdAt             DateTime            @default(now())
  items                 StockTransferItem[]

  @@index([sourceLocationId, transferDate])
  @@index([destinationLocationId, transferDate])
}

model StockTransferItem {
  id              String        @id @default(cuid())
  stockTransferId String
  transfer        StockTransfer @relation(fields: [stockTransferId], references: [id])
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Int

  @@index([productId])
  @@index([stockTransferId])
}

// ---------- Phase 5: sales ----------

enum SaleStatus {
  ACTIVE
  CANCELLED
}

enum PaymentStatus {
  PAID
  PARTIALLY_PAID
  UNPAID
}

// A sale is immutable once confirmed — the only future mutation is Phase 6's
// cancellation. Money fields are whole MRU (D-004). Snapshots (product name,
// customer name/phone, unit cost at sale time) protect history against later
// rename/edit of the underlying rows (spec §37.14). See D-012 for why
// amountPaidAtSale is a distinct field from amountPaid.
model Sale {
  id                    String              @id @default(cuid())
  referenceNumber       String              @unique
  shopId                String
  shop                  Shop                @relation(fields: [shopId], references: [id])
  customerId            String?
  customer              Customer?           @relation(fields: [customerId], references: [id])
  customerNameSnapshot  String?
  customerPhoneSnapshot String?
  status                SaleStatus          @default(ACTIVE)
  paymentStatus         PaymentStatus
  totalAmount           Int
  // Cash taken when the sale was made. Never mutated after confirmation.
  amountPaidAtSale      Int                 @default(0)
  // amountPaidAtSale + Σ active allocations (Phase 6). Kept as an invariant,
  // recomputed by the payments service — never patched.
  amountPaid            Int
  amountDue             Int
  saleDate              DateTime
  notes                 String?
  createdBy             String
  cancelledBy           String?
  cancelledAt           DateTime?
  cancellationReason    String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  items                 SaleItem[]
  // Phase 6 back-relations. Allocations "count" iff BOTH this sale and the
  // parent payment are ACTIVE (D-013) — filter in queries, never here.
  allocations           PaymentAllocation[]

  @@index([shopId, saleDate])
  @@index([customerId, paymentStatus])
  @@index([saleDate])
}

model SaleItem {
  id                  String  @id @default(cuid())
  saleId              String
  sale                Sale    @relation(fields: [saleId], references: [id])
  productId           String
  product             Product @relation(fields: [productId], references: [id])
  productNameSnapshot String
  quantity            Int
  unitPrice           Int
  // product.defaultPurchaseCost at sale time (may be null). Used later by
  // margin reports (Phase 7); snapshotted so later cost edits don't rewrite
  // history.
  unitCostSnapshot    Int?
  lineTotal           Int

  @@index([productId])
  @@index([saleId])
}

// ---------- Phase 6: customer payments & allocations ----------

enum CustomerPaymentStatus {
  ACTIVE
  CANCELLED
}

// A CustomerPayment represents money received AFTER a sale (D-012) — cash
// taken at sale time lives on Sale.amountPaidAtSale. Reversal flips status
// to CANCELLED and recomputes each touched sale's amountPaid from scratch
// (amountPaidAtSale + Σ active allocations). debtBeforePayment /
// debtAfterPayment are snapshots so receipts read the numbers as printed,
// even after later reversals (spec §23.4).
model CustomerPayment {
  id                 String                @id @default(cuid())
  referenceNumber    String                @unique
  customerId         String
  customer           Customer              @relation(fields: [customerId], references: [id])
  // Shop that received the cash. Cash-collected reports (Phase 7) sum
  // ACTIVE payments by shopId + paymentDate; no separate cash table.
  shopId             String
  shop               Shop                  @relation(fields: [shopId], references: [id])
  amount             Int
  paymentDate        DateTime
  debtBeforePayment  Int
  debtAfterPayment   Int
  notes              String?
  status             CustomerPaymentStatus @default(ACTIVE)
  createdBy          String
  cancelledBy        String?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime              @default(now())
  allocations        PaymentAllocation[]

  @@index([customerId, paymentDate])
  @@index([shopId, paymentDate])
}

// An allocation carries no status of its own — liveness is derived from
// its two parents (D-013): active iff payment.status = ACTIVE AND
// sale.status = ACTIVE. Never deleted or flagged; reversals recompute
// touched sales' balances instead of patching allocation rows.
// @@unique([customerPaymentId, saleId]) makes the "one payment allocates to
// a sale at most once" property structural — the oldest-first walk produces
// exactly that shape, and any code that would violate it can't insert.
model PaymentAllocation {
  id                String          @id @default(cuid())
  customerPaymentId String
  payment           CustomerPayment @relation(fields: [customerPaymentId], references: [id])
  saleId            String
  sale              Sale            @relation(fields: [saleId], references: [id])
  amountAllocated   Int
  createdAt         DateTime        @default(now())

  @@unique([customerPaymentId, saleId])
  @@index([saleId])
}

// ---------- Phase 7: expenses ----------

enum ExpenseStatus {
  ACTIVE
  CANCELLED
}

// An expense is money spent by the business, recorded against a shop
// (spec §26). Cancellation-not-deletion (spec §26.3): a cancelled
// expense stays in history and drops out of every active total by
// the report layer's ACTIVE filter. Description is required so the
// audit trail always answers "what was this for"; category is
// optional because the vocabulary evolves with the business.
model Expense {
  id                 String           @id @default(cuid())
  referenceNumber    String           @unique
  shopId             String
  shop               Shop             @relation(fields: [shopId], references: [id])
  categoryId         String?
  category           ExpenseCategory? @relation(fields: [categoryId], references: [id])
  amount             Int
  expenseDate        DateTime
  description        String
  notes              String?
  status             ExpenseStatus    @default(ACTIVE)
  createdBy          String
  cancelledBy        String?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([shopId, expenseDate])
  @@index([categoryId])
}
