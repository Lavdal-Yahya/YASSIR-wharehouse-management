# Copy this to .env and fill in values.
# The API fails to start if any required var is missing or invalid — by design.

NODE_ENV=development
PORT=3000

# PostgreSQL connection string (matches docker-compose defaults for local dev)
DATABASE_URL=postgresql://app:app@localhost:5432/shopdb

# Session cookie signing/HMAC secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 64 characters.
SESSION_SECRET=change-me-to-a-64-plus-character-random-string-not-this-placeholder-value

# CORS origin for the SPA. Cookies require exact match; no wildcards.
WEB_ORIGIN=http://localhost:5173

# Seed script — creates the initial OWNER user if none exists.
# Dev only. Production MUST override these with strong values.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-in-production
