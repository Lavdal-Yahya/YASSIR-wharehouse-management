# Production environment — copy this file to .env and fill in every value:
#   cp env.production.example .env
# Then run: docker compose -f docker-compose.prod.yml up -d
#
# Generate SESSION_SECRET:
#   openssl rand -hex 64
#
# Never commit the real .env file.  It is listed in .gitignore.

# ---------------------------------------------------------------------------
# Public domain (no trailing slash, no protocol — Caddy adds https://)
# ---------------------------------------------------------------------------
DOMAIN=warehouse.example.com

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
DB_USER=app
DB_PASSWORD=change_me_strong_password
DB_NAME=shopdb

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Full public origin of the app — used for CORS and cookie SameSite checks.
WEB_ORIGIN=https://warehouse.example.com

# 64-byte random secret for session signing.
# Generate: openssl rand -hex 64
SESSION_SECRET=replace_with_64_byte_hex_string_generated_by_openssl_rand_hex_64

# ---------------------------------------------------------------------------
# Seed admin (created on first `prisma migrate deploy` if not exists)
# ---------------------------------------------------------------------------
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change_me_strong_password
